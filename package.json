{
  "name": "omp-openchamber-server",
  "version": "0.1.0",
  "description": "OpenCode HTTP API proxy bridging OpenChamber to oh-my-pi (omp) RPC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvins82/omp-openchamber-server.git"
  },
  "homepage": "https://github.com/alvins82/omp-openchamber-server#readme",
  "license": "MIT",
  "author": "Alvin",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "prepare:omp": "bun scripts/prepare-omp.ts",
    "verify:omp": "bun scripts/prepare-omp.ts --verify",
    "test": "bun test",
    "check": "bun run --bun tsc --noEmit",
    "test:live": "OC_LIVE=1 bun test src/integration.live.test.ts"
  },
  "ompVersion": "18.1.15",
  "type": "module",
  "dependencies": {
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
